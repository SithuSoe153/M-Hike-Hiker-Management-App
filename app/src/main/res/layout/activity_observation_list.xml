        android:text="Date"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/lbl_Date1"
        android:textSize="30sp"
        android:text="lbl_Date1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        />

</LinearLayout>

</LinearLayout>

